{
  "id": null,
  "uid": "rpi-metrics-bridge",
  "title": "RPi Metrics Bridge",
  "description": "Homelab Pi 5 dashboard fed by the rpi-metrics-bridge Prometheus textfile collector (rpi-health, host-health, rpi-cooling, rpi-rtc, rpi-pcie, rpi-boot-config, rpi-connect, rpi-gpio-inventory, rpi-camera, apt-inventory).",
  "tags": ["rpi", "homelab", "swamp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "row", "title": "Staleness / Heartbeat", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },

    {
      "id": 2, "type": "timeseries", "title": "Capture Age by Source",
      "description": "Seconds since each source's last successful capture. Should hover near 0-60s; a rising line means that source's collect step is failing.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "rpi_metrics_bridge_capture_age_seconds", "legendFormat": "{{source}}", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Bridge Export Freshness",
      "description": "Seconds since rpi_metrics.prom was last written by the timer. Alert if > 300.",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 180 }, { "color": "red", "value": 300 }
      ] } }, "overrides": [] },
      "targets": [{ "expr": "time() - node_textfile_mtime_seconds{file=~\".*rpi_metrics.prom\"}", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Textfile Scrape Error",
      "description": "1 if node_exporter failed to parse any textfile collector file (malformed write, permissions, etc).",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "ERROR", "color": "red" } } }
      ], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "targets": [{ "expr": "node_textfile_scrape_error", "refId": "A" }]
    },

    { "id": 10, "type": "row", "title": "Thermal / Power", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "panels": [] },

    {
      "id": 11, "type": "timeseries", "title": "SoC / Filesystem Temperature",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "celsius", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "expr": "rpi_health_core_temp_celsius", "legendFormat": "SoC core temp", "refId": "A" },
        { "expr": "host_max_thermal_celsius", "legendFormat": "max thermal zone", "refId": "B" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Core / Supply Voltage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "volt", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "expr": "rpi_health_core_volts", "legendFormat": "core volts", "refId": "A" },
        { "expr": "rpi_health_supply_volts", "legendFormat": "supply volts", "refId": "B" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Estimated Total Power Draw",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "watt", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "rpi_health_estimated_total_watts", "legendFormat": "watts", "refId": "A" }]
    },
    {
      "id": 14, "type": "timeseries", "title": "ARM Clock Speed",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "hertz", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "rpi_health_arm_hertz", "legendFormat": "ARM freq", "refId": "A" }]
    },
    {
      "id": 15, "type": "stat", "title": "Sticky Fault Bits (since boot)",
      "description": "1 = fault occurred at some point since boot, even if not currently active. healthy=0 means at least one sticky bit is set.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "no", "color": "green" }, "1": { "text": "YES", "color": "red" } } }
      ] }, "overrides": [] },
      "targets": [
        { "expr": "rpi_health_undervoltage_since_boot", "legendFormat": "undervoltage", "refId": "A" },
        { "expr": "rpi_health_throttled_since_boot", "legendFormat": "throttled", "refId": "B" },
        { "expr": "rpi_health_arm_freq_capped_since_boot", "legendFormat": "freq capped", "refId": "C" },
        { "expr": "rpi_health_soft_temp_limit_reached_since_boot", "legendFormat": "soft temp limit", "refId": "D" }
      ]
    },

    { "id": 20, "type": "row", "title": "Fan / Cooling", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "panels": [] },

    {
      "id": 21, "type": "timeseries", "title": "Fan RPM",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "rotrpm", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "rpi_cooling_fan_rpm", "legendFormat": "rpm", "refId": "A" }]
    },
    {
      "id": 22, "type": "timeseries", "title": "Fan PWM Duty Cycle",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "rpi_cooling_fan_pwm_percent", "legendFormat": "pwm %", "refId": "A" }]
    },
    {
      "id": 23, "type": "timeseries", "title": "Cooling State",
      "description": "Current cooling-device state vs. its max state (thermal governor step level, not a temperature).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "expr": "rpi_cooling_state", "legendFormat": "state", "refId": "A" },
        { "expr": "rpi_cooling_max_state", "legendFormat": "max state", "refId": "B" }
      ]
    },
    {
      "id": 24, "type": "stat", "title": "Fan Stalled",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "running", "color": "green" }, "1": { "text": "STALLED", "color": "red" } } }
      ] }, "overrides": [] },
      "targets": [{ "expr": "rpi_cooling_fan_stalled", "refId": "A" }]
    },

    { "id": 30, "type": "row", "title": "Filesystem / Memory / Load", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "panels": [] },

    {
      "id": 31, "type": "timeseries", "title": "Disk Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "expr": "host_root_used_percent", "legendFormat": "root fs", "refId": "A" },
        { "expr": "host_worst_used_percent", "legendFormat": "worst mount", "refId": "B" }
      ]
    },
    {
      "id": 32, "type": "timeseries", "title": "Memory Used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "host_memory_used_percent", "legendFormat": "memory used %", "refId": "A" }]
    },
    {
      "id": 33, "type": "timeseries", "title": "Swap Used",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "host_swap_used_bytes", "legendFormat": "swap used", "refId": "A" }]
    },
    {
      "id": 34, "type": "timeseries", "title": "Load Average",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "expr": "host_load1", "legendFormat": "load1", "refId": "A" },
        { "expr": "host_load5", "legendFormat": "load5", "refId": "B" },
        { "expr": "host_load15", "legendFormat": "load15", "refId": "C" }
      ]
    },
    {
      "id": 35, "type": "timeseries", "title": "Load5 per Core",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "host_load5_per_core_ratio", "legendFormat": "load5/core", "refId": "A" }]
    },
    {
      "id": 36, "type": "timeseries", "title": "Process Counts",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "expr": "host_runnable_procs", "legendFormat": "runnable", "refId": "A" },
        { "expr": "host_total_procs", "legendFormat": "total", "refId": "B" }
      ]
    },

    { "id": 40, "type": "row", "title": "Packages / Security / Misc", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 }, "panels": [] },

    {
      "id": 41, "type": "stat", "title": "Upgradable Packages",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [
        { "matcher": { "id": "byName", "options": "security" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }] }
      ] },
      "targets": [
        { "expr": "apt_upgradable_packages", "legendFormat": "total", "refId": "A" },
        { "expr": "apt_security_upgradable_packages", "legendFormat": "security", "refId": "B" }
      ]
    },
    {
      "id": 42, "type": "stat", "title": "Installed / Autoremove Pending",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "expr": "apt_installed_packages", "legendFormat": "installed", "refId": "A" },
        { "expr": "apt_autoremove_pending", "legendFormat": "autoremove pending", "refId": "B" }
      ]
    },
    {
      "id": 43, "type": "bargauge", "title": "Upgrades Pending by Origin",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [{ "expr": "apt_upgrades_pending", "legendFormat": "{{origin}}", "refId": "A" }]
    },
    {
      "id": 44, "type": "stat", "title": "PCIe / RTC / Connect",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 73 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "no", "color": "green" }, "1": { "text": "yes", "color": "orange" } } }
      ] }, "overrides": [] },
      "targets": [
        { "expr": "rpi_pcie_link_degraded", "legendFormat": "PCIe link degraded", "refId": "A" },
        { "expr": "rpi_rtc_system_clock_synchronized", "legendFormat": "RTC synced", "refId": "B" },
        { "expr": "rpi_connect_signed_in", "legendFormat": "Connect signed in", "refId": "C" }
      ]
    },
    {
      "id": 45, "type": "timeseries", "title": "RTC Drift",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 73 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [{ "expr": "rpi_rtc_drift_seconds", "legendFormat": "drift", "refId": "A" }]
    },
    {
      "id": 46, "type": "stat", "title": "GPIO / Camera / Boot Config",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 81 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "expr": "rpi_gpio_pin_count", "legendFormat": "GPIO pins", "refId": "A" },
        { "expr": "rpi_camera_count", "legendFormat": "cameras detected", "refId": "B" },
        { "expr": "rpi_camera_output_recognized", "legendFormat": "camera output recognized", "refId": "C" },
        { "expr": "rpi_boot_config_eeprom_content_hash", "legendFormat": "boot config hash", "refId": "D" }
      ]
    }
  ]
}
